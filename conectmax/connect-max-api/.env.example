NODE_ENV=production
HOST=127.0.0.1
PORT=4182
API_KEY=troque-por-openssl-rand-hex-32

# Isolamento: só ConnectMax Campinas (não exponha via query)
FRANQUIA_ID=9
FRANQUIA_NOME=Campinas
# Teto duro de itens por resposta (sem query/paginação)
EXTRACT_LIMIT=50

# Portal franqueado (sessão upstream)
CONECTMAX_FRANQUEADO_USER=
CONECTMAX_FRANQUEADO_PASS=
CONECTMAX_FRANQUEADO_CONFIG_DIR=/var/lib/connect-max-api

# Postgres réplica Contabo (rotas /db/*)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=connectmax
DB_PASSWORD=
DB_NAME=connectmax
