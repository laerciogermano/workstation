# Copie para api/.env (nunca commitar o .env)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://email_marketing:email_marketing@localhost:5434/email_marketing

# URL pública da API (usada no link de descadastro dos e-mails)
PUBLIC_BASE_URL=http://localhost:4000
# Origem do front-end (CORS em dev; em produção sirva atrás do mesmo domínio)
WEB_ORIGIN=http://localhost:5173

# Envio (dev = Mailpit; Contabo Mailcow = mail.conectmax.email:587)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Contabo Mailcow: SMTP_TLS_REJECT_UNAUTHORIZED=false (cert SMTP autoassinado)
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAIL_FROM="Connect <marketing@connect.local>"
# Produção Contabo exemplo:
# SMTP_HOST=mail.conectmax.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=marketing@conectmax.email
# SMTP_PASS=...
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# MAIL_FROM="Connect <marketing@conectmax.email>"
# Limite de envios por segundo do worker
SEND_RATE_PER_SECOND=10
SEND_MAX_ATTEMPTS=3

LOG_LEVEL=info
