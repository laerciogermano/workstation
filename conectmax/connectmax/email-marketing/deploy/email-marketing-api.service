[Unit]
Description=Connect email-marketing API
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/email-marketing/api
EnvironmentFile=/srv/email-marketing/.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
