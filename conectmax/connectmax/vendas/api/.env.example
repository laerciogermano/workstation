PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=connectmax
DB_PASSWORD=connectmax
DB_NAME=connectmax
# true só em local; em produção use migrações e DB_SYNC=false
DB_SYNC=true

# Auth JWT + RBAC (admin | operador | viewer)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=12h
AUTH_ADMIN_EMAIL=admin@connectmax.local
AUTH_ADMIN_PASSWORD=ChangeMeAdmin!2026
# Scripts/agentes: X-Api-Key global (admin) — preferir chave por agente (POST /agentes/:id/api-key)
AGENT_API_KEY=troque-esta-api-key-do-agente
# Worker offline se last_heartbeat_at > este ms (default 120s)
# AGENT_HEARTBEAT_STALE_MS=120000
# GET /extract/start → login-extract-profiles
# GET /extract/detail/start?id= → login-extract-profile-detail --id
EXTRACT_CWD=../../../../screen-robot/src
# URL que o script usa no POST (default: http://127.0.0.1:$PORT)
# PROFILES_API_URL=http://127.0.0.1:3000

# AVDs (docker no servidor via SSH — requer sshpass se senha)
# AVD_ARTIFACTS_DIR=/root/avd-artifacts
# AVD_DEFAULT_IMAGE=us-docker.pkg.dev/android-emulator-268719/images/30-google-x64-no-metrics:30.1.2
# AVD_MAX_ATIVOS_POR_SERVIDOR=4

# Loop do agente (POST /agente/:id/claim)
# AGENT_INBOX_INTERVAL_MS=14400000   # ler_mensagens: 4h
# AGENT_CONNECTIONS_INTERVAL_MS=14400000   # verificar_conexoes: 4h
# AGENT_CONNECTIONS_CHECK_N=20
# AGENT_EXTRACT_DAILY_LIMIT=10   # extrair_leads: N candidatos/agente/dia (obrigatório)
# AGENT_EXTRACT_INTERVAL_MS=14400000   # extrair_leads: 4h entre runs
# AGENT_CONNECT_DAILY_LIMIT=15
# AGENT_CONNECT_BATCH_SIZE=1
# AGENT_CONNECT_BATCH_INTERVAL_MS=3600000   # conectar: 1h entre convites (lote=1)
# AGENT_PROSPECCAO_DAILY_LIMIT=15
# AGENT_PROSPECCAO_INTERVAL_MS=1800000   # sucesso: 30min; teste local=300000 (5min)
# AGENT_PROSPECCAO_RETRY_INTERVAL_MS=300000
# AGENT_MATERIALIZE_TYPES=verificar_conexoes,conectar
# AGENT_ENVIAR_PROSPECCAO_ENABLED=1   # default on; =0 desliga AC-02
# AGENT_CLAIM_TIMEOUT_MS=600000

# Extract: máx. perfis por run do script (teto diário = AGENT_EXTRACT_DAILY_LIMIT)
# EXTRACT_MAX_PROFILES=5
