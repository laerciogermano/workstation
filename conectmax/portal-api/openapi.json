                      "totalTexto": "R$ 3.780,00"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/fluxo-previsto": {
      "get": {
        "tags": [
          "financeiro"
        ],
        "summary": "Fluxo previsto × real (gráfico)",
        "description": "Fonte portal `?page=fluxo_previsto`",
        "operationId": "getFluxoPrevisto",
        "parameters": [
          {
            "name": "data",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "example": "2026-11"
            },
            "description": "Mês de referência (YYYY-MM)"
          },
          {
            "name": "mes",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "description": "Alias de data"
          },
          {
            "$ref": "#/components/parameters/refresh"
          }
        ],
        "responses": {
          "200": {
            "description": "Séries mensais",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FluxoPrevistoResponse"
                },
                "example": {
                  "fonte": "portal franqueado · fluxo_previsto",
                  "dataRef": "2026-11",
                  "labels": [
                    "Janeiro",
                    "Fevereiro",
                    "Março"
                  ],
                  "series": [
                    {
                      "label": "Faturamento previsto",
                      "data": [
                        438336.28,
                        649692.75,
                        null
                      ]
                    },
                    {
                      "label": "Faturamento real",
                      "data": [
                        512988.78,
                        570006.75,
                        null
                      ]
                    }
                  ],
                  "meses": [
                    {
                      "mes": "Janeiro",
                      "indice": 1,
                      "faturamento_previsto": 438336.28,
                      "faturamento_real": 512988.78
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/chamados": {
      "get": {
        "tags": [
          "suporte"
        ],
        "summary": "Lista chamados",
        "description": "Fonte portal `?page=chamados`",
        "operationId": "getChamados",
        "parameters": [
          {
            "$ref": "#/components/parameters/dataInicial"
          },
          {
            "$ref": "#/components/parameters/dataFinal"
          },
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "iniciado",
                "em andamento",
                "finalizado"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/refresh"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista (pode ser vazia)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChamadosResponse"
                },
                "example": {
                  "fonte": "portal franqueado · chamados",
                  "total": 0,
                  "porStatus": {},
                  "chamados": []
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/notificacoes": {
      "get": {
        "tags": [
          "suporte"
        ],
        "summary": "Lista notificações",
        "description": "Fonte portal `?page=notificacoes`",
        "operationId": "getNotificacoes",
        "parameters": [
          {
            "$ref": "#/components/parameters/dataInicial"
          },
          {
            "$ref": "#/components/parameters/dataFinal"
          },
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/refresh"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista (pode ser vazia)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificacoesResponse"
                },
                "example": {
                  "fonte": "portal franqueado · notificacoes",
                  "total": 0,
                  "notificacoes": []
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "dataInicial": {
        "name": "data_inicial",
        "in": "query",
        "schema": {
          "type": "string",
          "example": "01/01/2025"
        },
        "description": "Início (dd/mm/yyyy). Default `01/01/2025`"
      },
      "dataFinal": {
        "name": "data_final",
        "in": "query",
        "schema": {
          "type": "string",
          "example": "31/12/2026"
        },
        "description": "Fim (dd/mm/yyyy). Default `31/12/2026`"
      },
      "from": {
        "name": "from",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Alias de data_inicial"
      },
      "to": {
        "name": "to",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Alias de data_final"
      },
      "idVendedor": {
        "name": "id_vendedor",
        "in": "query",
        "schema": {
          "type": "string",
          "example": "75"
        },
        "description": "ID do vendedor no portal"
      },
      "currentPage": {
        "name": "current_page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "Só essa página (desliga varredura all)"
      },
      "all": {
        "name": "all",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1",
            "true",
            "false"
          ]
        },
        "description": "1 = varre todas as páginas (default se sem current_page)"
      },
      "refresh": {
        "name": "refresh",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1",
            "true",
            "false"
          ]
        },
        "description": "1 = força novo login no portal"
      }
    },
    "responses": {
      "Error": {
        "description": "Erro",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
