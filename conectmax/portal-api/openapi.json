{
  "openapi": "3.0.3",
  "info": {
    "title": "ConectMax Portal API",
    "description": "API local que autentica no Portal do Franqueado\n(`https://franqueado.conectmax.com/`) e expõe GETs de busca.\n\nCredenciais: `~/.config/conectmax-franqueado/credentials.env`\n",
    "version": "1.0.0",
    "contact": {
      "name": "ConectMax lab"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4175",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "meta"
    },
    {
      "name": "financeiro"
    },
    {
      "name": "comercial"
    },
    {
      "name": "fiscal"
    },
    {
      "name": "suporte"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "ok": true,
                  "service": "conectmax-portal-api"
                }
              }
            }
          }
        }
      }
    },
    "/catalog": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Catálogo de GETs do portal + status da API",
        "operationId": "getCatalog",
        "responses": {
          "200": {
            "description": "Catálogo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Alias de /catalog",
        "operationId": "getRoot",
        "responses": {
          "200": {
            "description": "Catálogo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Spec OpenAPI (JSON)",
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "OpenAPI 3",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "UI Swagger",
        "operationId": "getDocs",
        "responses": {
          "200": {
            "description": "HTML Swagger UI",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/faturas": {
      "get": {
        "tags": [
          "financeiro"
        ],
        "summary": "Lista faturas (contas a receber)",
        "description": "Fonte portal `?page=contasareceber`",
        "operationId": "getFaturas",
        "parameters": [
          {
            "$ref": "#/components/parameters/dataInicial"
          },
          {
            "$ref": "#/components/parameters/dataFinal"
          },
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "Aberta",
                "Quitada",
                "Vencida",
                "Próxima ao vencimento",
                "Estornada",
                "Falta arquivo"
              ]
            },
            "description": "Filtro local no JSON"
          },
          {
            "name": "status_portal",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filtro enviado ao portal"
          },
          {
            "name": "contato",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1",
                "true",
                "false"
              ]
            },
            "description": "1 = enriquece cada fatura com email/telefone/whatsapp via GET pedido (cache)"
          },
          {
            "$ref": "#/components/parameters/refresh"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de faturas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaturasResponse"
                },
                "example": {
                  "fonte": "portal franqueado · contasareceber",
                  "dataInicial": "01/11/2026",
                  "dataFinal": "06/11/2026",
                  "total": 10,
                  "totalValor": 21198.5,
                  "porStatus": {
                    "Quitada": 7,
                    "Vencida": 3
                  },
                  "faturas": [
                    {
                      "id": 20897,
                      "status": "Quitada",
                      "vencimento": "02/11/2026",
                      "titulo": "Fatura 3 da nota fiscal nº 288",
                      "faturaN": 3,
                      "nfNumero": 288,
                      "idNota": 17158,
                      "pedido": 16620,
                      "cliente": "INDUSTRIA DRYKO LTDA",
                      "cnpj": "03.081.895/0005-58",
                      "descricao": null,
                      "valor": 89,
                      "valorTexto": "R$ 89,00"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/pedidos/{id}": {
      "get": {
        "tags": [
          "comercial"
        ],
        "summary": "Detalhe do pedido (contato + itens)",
        "description": "Cabeçalho/contato: `?page=pedidos_edicao&id_pedido={id}&action=visualizar`.\nItens: `POST /franqueado/ajax/pedidos/produtos.php`.\n",
        "operationId": "getPedidoById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 17050
          },
          {
            "$ref": "#/components/parameters/refresh"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhe com contato e itens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PedidoDetalheResponse"
                },
                "example": {
                  "fonte": "portal franqueado · pedidos_edicao",
                  "cache": false,
                  "pedido": {
                    "id": 17050,
                    "status": "Aprovado",
                    "cliente": "INDUSTRIA DRYKO LTDA",
                    "email": "Wesley.araujo@dryko.com.br",
                    "telefone": "(11) 98503.5628",
                    "whatsapp": "11985035628",
                    "itensTotal": 3,
                    "itens": [
                      {
                        "idProduto": 36154,
                        "produto": "UBIQUITI USW-24-POE-BR UNIFI SWITCH 24P GIGABIT 2P SFP 95W",
                        "ncm": "85176234",
                        "quantidade": 1,
                        "valorUnitario": 2600,
                        "lucroPercentual": 28,
                        "valorExtra": 272,
                        "total": 3600
                      }
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/orcamentos": {
      "get": {
        "tags": [
          "comercial"
        ],
        "summary": "Lista orçamentos",
        "description": "Fonte portal `?page=orcamentos`",
        "operationId": "getOrcamentos",
        "parameters": [
          {
            "$ref": "#/components/parameters/dataInicial"
          },
          {
            "$ref": "#/components/parameters/dataFinal"
          },
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "Em aberto",
                "Aprovado",
                "Reprovado",
                "Contra proposta",
                "Cancelado",
                "Enviado"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/idVendedor"
          },
          {
            "$ref": "#/components/parameters/currentPage"
          },
          {
            "$ref": "#/components/parameters/all"
          },
          {
            "$ref": "#/components/parameters/refresh"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de orçamentos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrcamentosResponse"
                },
                "example": {
                  "fonte": "portal franqueado · orcamentos",
                  "dataInicial": "01/11/2026",
                  "dataFinal": "06/11/2026",
                  "pagesFetched": 1,
                  "total": 23,
                  "totalValor": 109473.08,
                  "porStatus": {
                    "Em aberto": 12,
                    "Enviado": 10,
                    "Aprovado": 1
                  },
                  "orcamentos": [
                    {
                      "id": 65690,
                      "numero": 3612,
                      "data": "05/11/2026",
                      "status": "Em aberto",
                      "cliente": "INSTITUTO CYRELA",
                      "vendedor": "Bruno Toyo",
                      "total": 57773.82,
                      "totalTexto": "R$ 57.773,82"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/pedidos": {
      "get": {
        "tags": [
          "comercial"
        ],
        "summary": "Lista pedidos",
        "description": "Fonte portal `?page=pedidos`",
        "operationId": "getPedidos",
        "parameters": [
          {
            "$ref": "#/components/parameters/dataInicial"
          },
          {
            "$ref": "#/components/parameters/dataFinal"
          },
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "Rascunho",
                "Em análise",
                "Aprovado",
                "Reprovado",
                "Cancelado",
                "Faturado"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/idVendedor"
          },
          {
            "$ref": "#/components/parameters/currentPage"
          },
          {
            "$ref": "#/components/parameters/all"
          },
          {
            "name": "itens",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1",
                "true",
                "false"
              ]
            },
            "description": "1 = inclui linhas de produto (POST produtos.php) por pedido"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Com itens=1, quantos pedidos enriquecer (do início da lista)"
          },
          {
            "$ref": "#/components/parameters/refresh"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pedidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PedidosResponse"
                },
                "example": {
                  "fonte": "portal franqueado · pedidos",
                  "pagesFetched": 1,
                  "total": 2,
                  "totalValor": 9699,
                  "pedidos": [
                    {
                      "id": 17050,
                      "numero": 17050,
                      "data": "05/11/2026",
                      "orcamento": 3589,
                      "status": "Aprovado",
                      "cliente": "INDUSTRIA DRYKO LTDA",
                      "vendedor": "Olívia",
                      "total": 6599,
                      "totalTexto": "R$ 6.599,00"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/notas-fiscais": {
      "get": {
        "tags": [
          "fiscal"
        ],
        "summary": "Lista notas fiscais",
        "description": "Fonte portal `?page=notas_fiscais`",
        "operationId": "getNotasFiscais",
        "parameters": [
          {
            "$ref": "#/components/parameters/dataInicial"
          },
          {
            "$ref": "#/components/parameters/dataFinal"
          },
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Ex. Enviado (filtro local); portal usa aguardando/cancelado/rejeitado/enviado via status_portal"
          },
          {
            "name": "tipo",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "manual",
                "pedido"
              ]
            }
          },
          {
            "name": "uf",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "SP"
            }
          },
          {
            "$ref": "#/components/parameters/idVendedor"
          },
          {
            "$ref": "#/components/parameters/currentPage"
          },
          {
            "$ref": "#/components/parameters/all"
          },
          {
            "$ref": "#/components/parameters/refresh"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de NFs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotasFiscaisResponse"
                },
                "example": {
                  "fonte": "portal franqueado · notas_fiscais",
                  "total": 4,
                  "totalValor": 6474.4,
                  "notasFiscais": [
                    {
                      "id": 17529,
                      "status": "Enviado",
                      "tipo": null,
                      "numero": 333,
                      "cliente": "VALID SOLUCOES S A",
                      "data": "04/11/2026 às 14:45:39",
                      "transportadora": "AGENCIA DE CORREIO",
                      "total": 344.4,
                      "totalTexto": "R$ 344,40",
                      "pdf": "/franqueado/ajax/notas_fiscais/pdf.php?id_nota=17529",
                      "xml": "/franqueado/ajax/notas_fiscais/xml.php?id_nota=17529"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/faturamento": {
      "get": {
        "tags": [
          "financeiro"
        ],
        "summary": "Faturamento (totais por vendedor + detalhe)",
        "description": "HTML `?page=faturamento` + Excel\n`/franqueado/ajax/faturamento/relatorio_excel.php`\n",
        "operationId": "getFaturamento",
        "parameters": [
          {
            "$ref": "#/components/parameters/dataInicial"
          },
          {
            "$ref": "#/components/parameters/dataFinal"
          },
          {
            "$ref": "#/components/parameters/from"
          },
          {
            "$ref": "#/components/parameters/to"
          },
          {
            "$ref": "#/components/parameters/idVendedor"
          },
          {
            "$ref": "#/components/parameters/refresh"
          }
        ],
        "responses": {
          "200": {
            "description": "Totais e detalhe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaturamentoResponse"
