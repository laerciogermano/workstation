# Imagem Android (15 64-bit é estável com scrcpy; 16 ainda tem bugs conhecidos)
REDROID_IMAGE=redroid/redroid:15.0.0_64only-latest

# ADB só em localhost (não use 0.0.0.0 em produção/rede pública)
ADB_HOST=127.0.0.1
ADB_PORT=5555

# Display
REDROID_WIDTH=720
REDROID_HEIGHT=1280
REDROID_DPI=320
REDROID_FPS=30

# guest = software | host = GPU do host | auto = detectar
REDROID_GPU_MODE=guest
