# Local (Colima/Docker): 127.0.0.1 + user/senha connectmax
# Contabo: IP da VPS
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=connectmax
DB_PASSWORD=connectmax
DB_NAME=connectmax
DB_SCHEMA=enotas
# Produção atrás do nginx: USE_HTTP=1 HOST=127.0.0.1 PORT=4173
# USE_HTTP=
# HOST=
# PORT=4173
# Microserviço ean-serp (REQ-044) — sugestões EAN na vitrine/detalhe
# EAN_SERP_URL=http://127.0.0.1:4180
# DB_CONNECT_TIMEOUT_MS=8000
# ALLOW_OFFLINE=1  # sobe sem Postgres (só enrichment); ENOTAS_DB=0 no boot
