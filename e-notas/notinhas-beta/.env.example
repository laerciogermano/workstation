# notinhas.shop Beta — copie para .env (nunca commitar .env)
NODE_ENV=development
HOST=127.0.0.1
PORT=4174
# URL pública do app (links de e-mail, CORS)
PUBLIC_URL=http://localhost:5188

# Postgres — por padrão o mesmo container do lab (enotas-postgres), schema próprio
DATABASE_URL=postgres://connectmax:connectmax@127.0.0.1:5432/connectmax
DB_SCHEMA=notinhas
# Schema do lab para `npm run db:import-lab`
LAB_SCHEMA=enotas

# Auth — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-com-32-ou-mais-caracteres
# Pepper do fingerprint (hash; o fingerprint cru nunca é gravado)
FINGERPRINT_PEPPER=troque-tambem-este-segredo-32-caracteres

# SEFAZ
SEFAZ_TIMEOUT_MS=10000

# E-mail (Mailcow). Vazio = em dev o link de reset vai para o log.
SMTP_URL=
MAIL_FROM="notinhas.shop <nao-responda@notinhas.shop>"

# Nominatim (geocodificação em segundo plano)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="notinhas.shop/1.0 (contato@notinhas.shop)"
