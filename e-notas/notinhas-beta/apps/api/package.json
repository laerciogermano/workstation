{
  "name": "@notinhas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed-demo.ts",
    "db:import-lab": "tsx --env-file-if-exists=../../.env src/scripts/import-lab.ts"
  },
  "dependencies": {
    "@notinhas/contracts": "*",
    "@notinhas/domain": "*",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.16",
    "nodemailer": "^10.4.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2"
  }
}
