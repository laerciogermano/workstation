# /etc/systemd/system/ean-serp.service — sugestão EAN (SI5) + Google Imagens p/ notinhas-api
[Unit]
Description=ean-serp (SI5 + Google Imagens)
After=network-online.target notinhas-chrome.service
Wants=network-online.target notinhas-chrome.service

[Service]
Type=simple
User=notinhas
WorkingDirectory=/opt/ean-serp
Environment=NODE_ENV=production PORT=4180 HOST=127.0.0.1
Environment=CDP_URL=http://127.0.0.1:9223
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
