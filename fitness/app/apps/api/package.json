{
  "name": "@fitness/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup && rm -rf dist/migrations && cp -r src/db/migrations dist/migrations",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fitness/contracts": "workspace:*",
    "@fitness/domain": "workspace:*",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
