{
  "name": "@flow/editor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Flow Editor — cria e altera fluxos (Flow Oriented Programming) sobre o Flow View",
  "author": "Laércio Germano",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "app": "npm run build && node scripts/serve.mjs",
    "test:browser": "npm run build && node test/browser.mjs",
    "verify": "npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "@flow/view": "file:../flow-view"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0.2",
    "vitest": "^5.1.2"
  }
}
