PORT=3000
NODE_ENV=development
# URL pública do front (link do e-mail de redefinição de senha)
APP_URL=http://localhost:5173
# Obrigatório em produção: string longa e aleatória (ex.: openssl rand -hex 32)
JWT_SECRET=troque-isto
# SQLite local; em produção apontar para volume persistente
DB_PATH=./data/rolego.sqlite
# Cria/atualiza tabelas automaticamente (desligar em produção depois da 1ª subida)
DB_SYNC=true
UPLOAD_DIR=./uploads

# Login Google (OAuth client "Web application"; origem JS = APP_URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Login Apple (Services ID + domínio/return URL cadastrados na Apple)
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# SMTP para e-mail de redefinição; vazio = link vai para o log do servidor
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RoleGo <nao-responda@rolego.com.br>"
