# Imagem: tag local (após ./scripts/build-image.sh) ou pull direto do registry Google.
DOCKER_AVD_IMAGE=screen-robot/docker-avd:playstore

# Alternativas hospedadas (sem build):
# DOCKER_AVD_IMAGE=us-docker.pkg.dev/android-emulator-268719/images/28-playstore-x64-no-metrics:30.1.2
# DOCKER_AVD_IMAGE=us-docker.pkg.dev/android-emulator-268719/images/30-google-x64-no-metrics:30.1.2

ADB_HOST=127.0.0.1
# Porta default sem name; com DOCKER_AVD_NAME o start.sh deriva 5655+(hash%100)
ADB_PORT=5655
GRPC_PORT=8655
