{
  "device": "emulator-5554",
  "provision": {
    "name": "ConnectMax_Cam",
    "kind": "avd",
    "serial": "emulator-5554",
    "connectTimeoutMs": 120000,
    "resetScript": "../pocs/android-studio/scripts/reset.sh"
  },
  "apps": {
    "instagram": {
      "package": "com.instagram.android",
      "version": "447.0.0.55.81",
      "source": "apk-pure",
      "artifact": "apks/com.instagram.android.xapk"
    },
    "linkedin": {
      "package": "com.linkedin.android",
      "version": "4.1.1248",
      "source": "apk-pure",
      "artifact": "apks/com.linkedin.android.xapk"
    },
    "tinder": {
      "package": "com.tinder",
      "source": "huawei-app-gallery",
      "artifact": "apks/com.tinder.apk"
    },
    "hms": {
      "package": "com.huawei.hwid",
      "source": "apk-pure",
      "artifact": "apks/com.huawei.hwid.apk"
    }
  },
  "credentials": {
    "linkedin": {
      "userEnv": "LINKEDIN_USER",
      "passwordEnv": "LINKEDIN_PASSWORD"
    }
  },
  "type": {
    "keyboardRegion": { "x": 0, "y": 700, "width": 720, "height": 520 }
  },
  "session": {
    "path": "./state/session.json"
  },
  "screenshot": {
    "path": "./screenshots/linkedin-before-login.png"
  }
}
