{
  "name": "screen-robot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Android via Node: provisionar, APKs, eventos, extrair, operar, sessão",
  "bin": {
    "screen-robot": "./cli.js"
  },
  "scripts": {
    "run": "node scripts/run-action.js",
    "extract": "node scripts/run-action.js extract",
    "find": "node scripts/run-action.js find",
    "tap": "node scripts/run-action.js tap",
    "type": "node scripts/run-action.js type",
    "scroll": "node scripts/run-action.js scroll",
    "launch": "node scripts/run-action.js launch",
    "key": "node scripts/run-action.js key",
    "wait": "node scripts/run-action.js wait",
    "example": "node cli.js config.example.json",
    "linkedin-login": "node scripts/linkedin-login.js",
    "tinder-home": "node scripts/tinder-home.js",
    "instagram-home": "node scripts/instagram-home.js",
    "sample": "node scripts/sample.js",
    "docker-avd": "node scripts/docker-avd-provision.js",
    "print": "node scripts/print.js",
    "ocr": "node scripts/ocr-image.js",
    "poc:vision": "node scripts/poc-vision-compress.js",
    "usage:report": "node scripts/build-usage-dashboard.js",
    "agent": "node scripts/run-agent.js",
    "agent:smoke": "node scripts/smoke-agent.js",
    "raw-gpt": "node scripts/raw-gpt.js",
    "raw-gpt:loop": "node scripts/raw-gpt-loop.js",
    "view": "bash scripts/view.sh",
    "test": "node --test 'lib/**/*.test.js'",
    "test:unit": "node --test 'lib/**/*.test.js'",
    "test:e2e": "node --test --test-concurrency=1 'test/bdd/**/*.test.js'"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "tesseract.js": "^5.1.1"
  }
}
